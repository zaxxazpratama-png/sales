{
  "version": 2,
  "builds": [
    {
      "src": "**/*.php",
      "use": "vercel-php@0.7.2"
    },
    {
      "src": "public/assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/admin/?$",
      "dest": "/public/admin/index.php"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/public/admin/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/preview_cbn.php",
      "dest": "/public/preview_cbn.php"
    },
    {
      "src": "/submit.php",
      "dest": "/public/submit.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
