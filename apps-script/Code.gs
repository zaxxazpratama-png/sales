    ${box(ttlMonth, 62.7, 14.07, 1.905, '9pt', 2)}
    ${box(ttlYear, 68.4, 14.07, 1.905, '9pt', 4)}
    ${box(ktp, 20.88, 16.63, 1.905, '9pt', 16)}
    
    ${isPria ? "<div class='fld' style='top:16.5%;left:75.6%;font-size:11pt;font-weight:bold;width:1.9%;text-align:center;'>X</div>" : ''}
    ${isWanita ? "<div class='fld' style='top:16.5%;left:84.4%;font-size:11pt;font-weight:bold;width:1.9%;text-align:center;'>X</div>" : ''}
    
    ${telpRumah && telpRumah !== telpSelular ? box(telpRumah, 20.88, 19.19, 1.905, '9pt', 12) : ''}
