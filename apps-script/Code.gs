      }
    }
  }

  if (cbnPackageLines.length === 0) {
    const sLow = service.toLowerCase();
    if (sLow.includes('20') || sLow.includes('50')) {
      cbnPackageLines = ['CBN Fiber July 2026 Package 1 (15 & 20 Mbps) [1]'];
    } else if (sLow.includes('100') || sLow.includes('200') || sLow.includes('1gbps')) {
