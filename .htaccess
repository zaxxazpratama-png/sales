<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /ALATTEMPUR/FORMGOOGLE/

    # Allow direct access to existing static asset files
    RewriteCond %{REQUEST_URI} ^/ALATTEMPUR/FORMGOOGLE/assets/ [OR]
    RewriteCond %{REQUEST_URI} ^/ALATTEMPUR/FORMGOOGLE/public/assets/
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    # Admin routes
    RewriteRule ^admin/?$ public/admin/index.php [L]
    RewriteRule ^admin/(.*)$ public/admin/$1 [L]

    # Specific PHP endpoints
    RewriteRule ^submit\.php$ public/submit.php [L]
    RewriteRule ^preview_cbn\.php$ public/preview_cbn.php [L]
    RewriteRule ^404/?$ public/404.php [L]

    # /s/KODE_SALES -> public/index.php?sales=KODE_SALES
    RewriteRule ^s/([a-zA-Z0-9_\-]+)/?$ public/index.php?sales=$1 [QSA,L]

    # /KODE_SALES (e.g. /SEP-001, /SEP-002) -> public/index.php?sales=KODE_SALES
    RewriteRule ^([a-zA-Z0-9_\-]+)/?$ public/index.php?sales=$1 [QSA,L]

    # Block direct /public/ access and fallback to 404
    RewriteRule ^public/?$ public/404.php [L]
    RewriteRule ^$ public/404.php [L]
</IfModule>

